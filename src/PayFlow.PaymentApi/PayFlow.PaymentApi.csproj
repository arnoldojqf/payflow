<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a99436a8-0d4c-49db-9aa8-fece4ca96550</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements compile to an internal Program class, which
         WebApplicationFactory<Program> needs to see. Granting the test project
         access keeps Program internal instead of widening the public surface. -->
    <InternalsVisibleTo Include="PayFlow.PaymentApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declared explicitly rather than inherited from the Design package, which
         is PrivateAssets=all and so does not flow to referencing projects. Without
         these, a referencing project resolves EF Core down to the Npgsql
         provider's minimum (10.0.4) and fails to bind against this assembly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <!-- The dispatcher's read path: a claim query and two set-based updates,
         none of which want EF's change tracker. -->
    <PackageReference Include="Dapper" Version="2.1.86" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayFlow.Contracts\PayFlow.Contracts.csproj" />
  </ItemGroup>

</Project>
