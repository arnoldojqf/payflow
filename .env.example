# Copy to .env only if you need to override the local development defaults:
#
#   cp .env.example .env
#
# docker-compose.yml falls back to these exact values when no .env exists,
# so a plain `docker compose up -d` works out of the box.
#
# Changing any of these means updating the PayFlowDb connection string in
# src/PayFlow.PaymentApi/appsettings.Development.json to match.
#
# Local development credentials only — never used for a deployed environment.

POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
